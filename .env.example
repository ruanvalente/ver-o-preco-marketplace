# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon/publishable) do Supabase. Defina APENAS UMA das aliases abaixo.
# Precedência em src/config/env.ts:
#   1. NEXT_PUBLIC_SUPABASE_ANON_KEY         (legado)
#   2. NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (preferida)
#   3. NEXT_PUBLIC_SUPABASE_KEY              (legado)
# Todas são variáveis NEXT_PUBLIC_*, ou seja, públicas no browser. Nunca coloque
# SUPABASE_SERVICE_ROLE_KEY nem qualquer outra credencial secreta neste arquivo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-public-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-key
# NEXT_PUBLIC_SUPABASE_KEY=your-supabase-public-key

# URL pública usada nos links de confirmação e recuperação de senha.
# Opcional em desenvolvimento (usa o host da requisição como fallback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
